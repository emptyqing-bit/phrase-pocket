{
  "manifest_version": 3,
  "name": "随手收",
  "description": "在 TikTok 网页记录英文表达和备忘，在 Windows 桌面复习。",
  "version": "0.4.0",
  "minimum_chrome_version": "123",
  "key": "",
  "permissions": ["storage"],
  "optional_permissions": ["nativeMessaging"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    { "matches": ["https://www.tiktok.com/*", "https://tiktok.com/*"], "js": ["captions.js", "capture.js"] }
  ],
  "action": { "default_title": "随手收 · 我的收藏" },
  "options_page": "library.html",
  "commands": {
    "capture": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "打开 TikTok 页内记录框" }
  }
}
