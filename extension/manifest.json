{
  "manifest_version": 3,
  "name": "随手收",
  "description": "在 TikTok、哔哩哔哩和抖音网页版记录英文表达与备忘，在 Windows 桌面复习。",
  "version": "0.6.0",
  "minimum_chrome_version": "123",
  "key": "",
  "permissions": ["storage"],
  "optional_permissions": ["nativeMessaging"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*", "https://tiktok.com/*",
        "https://www.bilibili.com/*", "https://bilibili.com/*",
        "https://www.douyin.com/*", "https://douyin.com/*"
      ],
      "js": ["sites.js", "captions.js", "capture.js"]
    }
  ],
  "action": { "default_title": "随手收 · 单词与备忘收藏" },
  "options_page": "library.html",
  "commands": {
    "capture": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "打开视频网页的随手收记录框" }
  }
}
